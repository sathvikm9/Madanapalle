DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker
PORT=8787
COLLECTOR_ENABLED=false
HEADLESS=false
BROWSER_DATA_DIR=./playwright-data
DISCOVERY_INTERVAL_SECONDS=120
DISCOVERY_DAYS_AHEAD=1
SCHEDULER_TICK_SECONDS=5
CAPTURE_RETRY_SECONDS=20
CORS_ORIGINS=http://localhost:5173
# Optional: protects POST /api/admin/discover
ADMIN_TOKEN=
# Shared only with the local Chrome capture agent
CAPTURE_AGENT_TOKEN=replace-with-a-long-random-token
# Optional: receives collector failure JSON via POST
ALERT_WEBHOOK_URL=
# Frontend build setting (set as a GitHub Actions variable/secret)
VITE_API_BASE=http://localhost:8787
